# Forma - Docker Compose settings. Copy to .env and edit.

# demo = fixed examples (no model calls). glm = your organisation's GLM endpoint.
MODEL_MODE=demo

# OpenAI-compatible Chat Completions prefix. Forma appends /chat/completions.
# Inside Docker, localhost is the container itself: use a reachable host name.
GLM_BASE_URL=http://your-internal-glm-host:8000/v1
GLM_MODEL=glm-5.3-flash
GLM_API_KEY=
GLM_REASONING_EFFORT=high
GLM_MAX_TOKENS=32768
GLM_TIMEOUT_MS=240000
GLM_JSON_MODE=false
GLM_EXTRA_BODY={}

# 0.3 engine settings. Empty values use the defaults shown in the comments.
# staged = plan, then build screens in parallel, then review (web); single = 0.2 one-call JSON.
GLM_PIPELINE=staged
# Max concurrent model calls inside one job (1-8).
GLM_PARALLEL=3
# Stream responses (SSE). Plain JSON replies are still accepted when false or unsupported.
GLM_STREAM=true
# auto = send images, retry once without them if the endpoint rejects them; on = always; off = text-only review.
GLM_VISION=auto
# Max images per request: reference images plus screenshots (0-32).
GLM_MAX_IMAGES=8
# Retries for network errors and HTTP 429/5xx, with 1s then 3s backoff (0-5).
GLM_RETRIES=2
# true sends response_format json_schema for calls with a schema (only if the endpoint supports it).
GLM_STRUCTURED_OUTPUT=false
# Per-stage reasoning_effort (low, high or max). Empty = GLM_REASONING_EFFORT; review defaults to low.
GLM_EFFORT_PLAN=
GLM_EFFORT_BUILD=
GLM_EFFORT_REVIEW=low
GLM_EFFORT_EDIT=

# Demo password. GLM mode refuses to start until it and the secrets are replaced.
APP_PASSWORD=local-pilot-change-me
SESSION_SECRET=replace-with-a-long-random-secret
RENDER_TOKEN=replace-with-another-long-random-secret

# Set true behind an HTTPS reverse proxy.
COOKIE_SECURE=false

# Generation jobs and GLM element edits share these worker slots.
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=20

# Optional: Poppler pdftotext for PDF source documents (otherwise found next to PDFINFO_PATH).
# PDFTOTEXT_PATH=/usr/bin/pdftotext

# Corporate CA mounted into the app container (PEM file).
# NODE_EXTRA_CA_CERTS=/certs/company-ca.pem
