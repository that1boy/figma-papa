# Forma - Docker Compose settings. Copy to .env and edit.

# demo = fixed examples (no model calls). glm = your organisation's GLM endpoint.
MODEL_MODE=demo

# OpenAI-compatible Chat Completions prefix. Forma appends /chat/completions.
# Inside Docker, localhost is the container itself: use a reachable host name.
GLM_BASE_URL=http://your-internal-glm-host:8000/v1
GLM_MODEL=glm-5.3-flash
GLM_API_KEY=
GLM_REASONING_EFFORT=high
GLM_MAX_TOKENS=32768
GLM_TIMEOUT_MS=240000
GLM_JSON_MODE=false
GLM_EXTRA_BODY={}

# Demo password. GLM mode refuses to start until it and the secrets are replaced.
APP_PASSWORD=local-pilot-change-me
SESSION_SECRET=replace-with-a-long-random-secret
RENDER_TOKEN=replace-with-another-long-random-secret

# Set true behind an HTTPS reverse proxy.
COOKIE_SECURE=false

MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=20

# Corporate CA mounted into the app container (PEM file).
# NODE_EXTRA_CA_CERTS=/certs/company-ca.pem
