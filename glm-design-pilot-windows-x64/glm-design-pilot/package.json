{
  "name": "glm-design-pilot",
  "version": "0.3.0",
  "private": true,
  "description": "An internal GLM-backed UI and UX design studio",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.cjs",
    "renderer": "node --env-file-if-exists=.env renderer.cjs",
    "test": "node --test test/*.test.cjs",
    "test:browser": "node test/browser.cjs && node test/studio-browser.cjs",
    "test:docker": "node test/docker-smoke.cjs",
    "test:studio": "node test/studio-browser.cjs",
    "test:glm-e2e": "node test/glm-e2e.cjs"
  },
  "dependencies": {
    "docx": "9.6.1",
    "pptxgenjs": "4.0.1",
    "playwright": "1.62.1",
    "sanitize-html": "2.18.0"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
