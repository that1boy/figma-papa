# Forma - portable Windows settings.
# 01-configure.cmd copies this file to .env and replaces the GENERATE_ values
# with random secrets created on this PC. Edit .env, not this template.

# demo = fixed examples (no model calls). glm = your organisation's GLM endpoint.
MODEL_MODE=demo

# OpenAI-compatible Chat Completions prefix. Forma appends /chat/completions.
GLM_BASE_URL=http://YOUR-INTERNAL-HOST:8000/v1
# Exact deployed model ID supplied by your inference team.
GLM_MODEL=glm-5.3-flash
# Leave empty if your endpoint needs no key.
GLM_API_KEY=
# low, high or max. GLM-5.3-Flash always thinks; this sets how much.
GLM_REASONING_EFFORT=high
GLM_MAX_TOKENS=32768
GLM_TIMEOUT_MS=240000
# true only if the endpoint supports response_format {type: "json_object"}.
GLM_JSON_MODE=false
# Optional JSON object of endpoint-specific parameters.
GLM_EXTRA_BODY={}

# 0.3 engine settings. Empty values use the defaults described here.
# staged = plan, then build screens in parallel, then review (web); single = 0.2 one-call JSON.
GLM_PIPELINE=staged
# Max concurrent model calls inside one job (1-8).
GLM_PARALLEL=3
# Stream responses (SSE). Plain JSON replies are still accepted when false or unsupported.
GLM_STREAM=true
# auto = send images, retry once without them if the endpoint rejects them; on = always; off = text-only review.
GLM_VISION=auto
# Max images per request: reference images plus screenshots (0-32).
GLM_MAX_IMAGES=8
# Retries for network errors and HTTP 429/5xx, with 1s then 3s backoff (0-5).
GLM_RETRIES=2
# true sends response_format json_schema for calls with a schema (only if the endpoint supports it).
GLM_STRUCTURED_OUTPUT=false
# Per-stage reasoning_effort (low, high or max). Empty = GLM_REASONING_EFFORT; review defaults to low.
GLM_EFFORT_PLAN=
GLM_EFFORT_BUILD=
GLM_EFFORT_REVIEW=low
GLM_EFFORT_EDIT=

# Browser login password (12+ characters) and internal secrets.
APP_PASSWORD=GENERATE_APP_PASSWORD
SESSION_SECRET=GENERATE_SESSION_SECRET
RENDER_TOKEN=GENERATE_RENDER_TOKEN

# Both services always listen on 127.0.0.1 in the Windows launcher.
PORT=8080
RENDER_PORT=8081

# Generation jobs and GLM element edits share these worker slots.
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=20

# Optional executable paths. Edge/Chrome and LibreOffice are auto-detected.
# BROWSER_EXECUTABLE=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
# LIBREOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe
# PDFINFO_PATH=C:/poppler/Library/bin/pdfinfo.exe
# PDFTOPPM_PATH=C:/poppler/Library/bin/pdftoppm.exe
# Poppler pdftotext reads PDF source documents (otherwise found next to PDFINFO_PATH).
# PDFTOTEXT_PATH=C:/poppler/Library/bin/pdftotext.exe

# Corporate CA for an HTTPS GLM endpoint (PEM file).
# NODE_EXTRA_CA_CERTS=C:/Certificates/company-ca.pem
